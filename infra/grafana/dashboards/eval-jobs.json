{
  "title": "OpenEval - Eval Jobs & Cost",
  "uid": "openeval-eval-jobs",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Eval jobs by terminal status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(openeval_eval_jobs_total[1h])) by (status)" }],
      "note": "Only visible when the Celery worker exposes /metrics too - see core/metrics.py ponytail note on multiprocess mode."
    },
    {
      "id": 2,
      "title": "LLM cost by model ($/hr)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(openeval_llm_cost_usd_total[1h])) by (model)" }]
    },
    {
      "id": 3,
      "title": "LLM cost by provider ($/hr)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(openeval_llm_cost_usd_total[1h])) by (provider)" }]
    }
  ]
}
